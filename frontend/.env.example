# Copy to .env (or .env.local) - Next.js loads either automatically - and fill in.
# Server-side only - do NOT prefix with NEXT_PUBLIC_.

# MongoDB connection string
#   local: mongodb://localhost:27017
#   Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=

# optional, defaults to jobhunters
# MONGODB_DB=

# --- Google sign-in (optional) -------------------------------------------
# Without these the site still works: everyone sees the shared sample data and
# the "Sign in with Google" button is disabled.
#
# Setup (console.cloud.google.com):
#   1. APIs & Services > Library: enable the "Gmail API".
#   2. APIs & Services > OAuth consent screen: add the scope
#      .../auth/gmail.readonly and, while the app is in "Testing", add your
#      Google account under "Test users".
#   3. APIs & Services > Credentials > Create credentials > OAuth client ID,
#      type "Web application", with this Authorised redirect URI:
#        http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI above exactly. Change it (and the console entry) when deployed.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 32+ random characters. Signs the sign-in cookie and encrypts stored Gmail tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later signs everyone out and makes stored Gmail tokens unreadable.
AUTH_SECRET=

# --- Gmail sync ------------------------------------------------------------
# New emails pulled from a user's Gmail are classified by a model through the Vercel AI Gateway
# (Vercel dashboard > AI Gateway > API Keys). One key for the whole server; without it the sync
# is switched off. On Vercel, add it under Project Settings > Environment Variables too.
AI_GATEWAY_API_KEY=
# optional, defaults to alibaba/qwen3.8-omni-flash (any model id from https://ai-gateway.vercel.sh/v1/models)
# AI_GATEWAY_MODEL=
# optional: how much the model reasons before answering: "off", an effort (none / minimal / low /
# medium / high), or "default" to leave it to the model. Unset means "off" for the default model
# (as accurate on our labelled emails, over twice as fast) and "default" for any other model.
# AI_GATEWAY_REASONING=
