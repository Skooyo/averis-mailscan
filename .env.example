# Model calls go through the Vercel AI Gateway (Vercel dashboard > AI Gateway > API Keys) --
# the same key and provider frontend/src/lib/classify.ts uses.
AI_GATEWAY_API_KEY=
# optional, defaults to alibaba/qwen3.8-omni-flash (any model id from https://ai-gateway.vercel.sh/v1/models)
# AI_GATEWAY_MODEL=
# optional, defaults to https://ai-gateway.vercel.sh/v1
# AI_GATEWAY_BASE_URL=

# Optional fallback: if the AI Gateway is rate-limited, erroring, or its key is unset/rejected,
# backend/llm.py automatically retries the same request against Groq instead. Leave unset to
# disable the fallback (a Gateway failure just raises).
GROQ_API_KEY=
# optional, defaults to openai/gpt-oss-120b
# GROQ_MODEL=

# Optional: Google Document AI OCR fallback (backend/ocr.py) for scanned,
# image-only PDFs where pdfplumber finds no text layer (email_512-514 in the
# sample inbox). All three required to enable it; leave unset and readers.py
# just reports pdf_no_text_layer as before.
PROJECT_ID=
PROCESSOR_ID=
LOCATION=

# Optional: write pipeline results into MongoDB Atlas (backend/db.py, `python -m backend.pipeline
# <data_dir> <limit> --write-db`) for the frontend (frontend/src/lib/results.ts) to read. Same
# variable names, same cluster, as frontend/.env.example -- keep both in sync.
#   local: mongodb://localhost:27017
#   Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=
# optional, defaults to jobhunters
# MONGODB_DB=
